---
import { experiences } from '../data/portfolio';
---

<section class="section shell" id="experience" aria-labelledby="experience-title">
	<div class="section-heading">
		<p class="section-index">02</p>
		<div>
			<h2 id="experience-title">Experience</h2>
			<p>Hands-on work across product development, integrations, testing, and deployment.</p>
		</div>
	</div>
	<div class="experience-list">
		{experiences.map((experience) => (
			<article class="experience">
				<div class="entry-heading">
					<div>
						<h3>{experience.company}</h3>
						<p class="entry-role">{experience.role}</p>
					</div>
					<time>{experience.period}</time>
				</div>
				<ul class="highlights">
					{experience.details.map((detail) => <li>{detail}</li>)}
				</ul>
			</article>
		))}
	</div>
</section>
