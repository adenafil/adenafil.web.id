---
import { profile } from '../data/portfolio';
---

<footer class="site-container site-footer">
	<p>© {new Date().getFullYear()} {profile.name} · Built with Astro</p>
	<nav class="site-footer__links" aria-label="Footer navigation">
		{profile.links.map((link) => {
			const opensNewTab = link.href.startsWith('http') || link.label === 'CV';
			return (
				<a href={link.href} target={opensNewTab ? '_blank' : undefined} rel={opensNewTab ? 'noreferrer' : undefined}>
					{link.label}
				</a>
			);
		})}
	</nav>
</footer>
