---
import { profile } from '../data/portfolio';
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="wordmark" href="#top" aria-label={`${profile.name}, back to top`}>{profile.shortName}</a>
		<nav aria-label="Main navigation">
			<a href="#work">Work</a>
			<a href="#experience">Experience</a>
			<a href="#about">About</a>
			<a class="nav-cv" href="/firmansah.pdf" target="_blank">CV</a>
			<button class="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
				<span aria-hidden="true"></span>
			</button>
		</nav>
	</div>
</header>

<script is:inline>
	const button = document.querySelector('.theme-toggle');
	button?.addEventListener('click', () => {
		const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = nextTheme;
		localStorage.setItem('theme', nextTheme);
	});
</script>
