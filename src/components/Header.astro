---
import { profile } from '../data/portfolio';
import ThemeToggle from './ThemeToggle';

const isAbout = Astro.url.pathname === '/about' || Astro.url.pathname === '/about/';
const isWorks = Astro.url.pathname === '/works' || Astro.url.pathname.startsWith('/works/');
---

<header class="sticky top-0 z-10 bg-[var(--header)] backdrop-blur-[14px]">
	<div class="site-container flex h-16 items-center justify-between md:h-[72px]">
		<a class="text-xl font-bold tracking-[-0.04em] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]" href="/" aria-label={`${profile.name}, home`}>{profile.shortName}</a>
		<nav class="flex items-center gap-4 sm:gap-[18px] md:gap-6" aria-label="Main navigation">
			<a class:list={["text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]", isWorks ? "text-[var(--ink)]" : "text-[var(--muted)] hover:text-[var(--ink)]"]} href="/works" aria-current={isWorks ? 'page' : undefined}>Works</a>
			<a class:list={["text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]", isAbout ? "text-[var(--ink)]" : "text-[var(--muted)] hover:text-[var(--ink)]"]} href="/about" aria-current={isAbout ? 'page' : undefined}>About</a>
			<a class="text-sm font-semibold text-[var(--ink)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]" href="/assets/firmansah.pdf" target="_blank" rel="noreferrer">CV</a>
			<ThemeToggle client:load />
		</nav>
	</div>
</header>
