---
import { profile } from '../data/portfolio';
---

<section class="site-container intro" aria-labelledby="intro-title">
	<img
		class="intro__photo"
		src="/profile.jpg"
		alt={`Portrait of ${profile.name}`}
		width="112"
		height="112"
		fetchpriority="high"
	/>

	<div>
		<h1 id="intro-title" class="intro__name">{profile.name}</h1>
		<p class="intro__role">{profile.role} · {profile.location}</p>
		<p class="intro__bio">{profile.intro}</p>
		<div class="intro__links" aria-label="Profile links">
			{profile.links.map((link) => {
				const opensNewTab = link.href.startsWith('http') || link.label === 'CV';
				return (
					<a
						class="text-link"
						href={link.href}
						target={opensNewTab ? '_blank' : undefined}
						rel={opensNewTab ? 'noreferrer' : undefined}
					>
						{link.label}
					</a>
				);
			})}
		</div>
	</div>
</section>
