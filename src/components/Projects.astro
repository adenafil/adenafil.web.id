---
import { projects } from '../data/portfolio';
---

<section class="section shell" id="work" aria-labelledby="work-title">
	<div class="section-heading">
		<p class="section-index">01</p>
		<div>
			<h2 id="work-title">Selected work</h2>
			<p>Products built around real operational needs, from scheduling optimization to commerce.</p>
		</div>
	</div>
	<div class="project-list">
		{projects.map((project, index) => (
			<article class="project">
				<div class="project-number" aria-hidden="true">0{index + 1}</div>
				<div class="project-main">
					<div class="entry-heading">
						<div>
							<h3>{project.name}</h3>
							<p class="entry-role">{project.type}</p>
						</div>
						<time>{project.year}</time>
					</div>
					<p class="project-description">{project.description}</p>
					<ul class="highlights">
						{project.highlights.map((highlight) => <li>{highlight}</li>)}
					</ul>
					<ul class="tags" aria-label={`${project.name} technologies`}>
						{project.technologies.map((technology) => <li>{technology}</li>)}
					</ul>
				</div>
			</article>
		))}
	</div>
</section>
