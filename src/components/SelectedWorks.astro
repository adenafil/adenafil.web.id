---
import type { CollectionEntry } from 'astro:content';
import ProjectListItem from './works/ProjectListItem.astro';

interface Props {
	projects: CollectionEntry<'works'>[];
}

const { projects } = Astro.props;
---

<ol class="works-list">
	{projects.map((project) => <ProjectListItem project={project} headingLevel={3} />)}
</ol>

<p class="more-link"><a class="text-link" href="/works">All works <span aria-hidden="true">→</span></a></p>
