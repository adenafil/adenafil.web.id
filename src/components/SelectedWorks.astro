---
import type { CollectionEntry } from 'astro:content';

interface Props {
	projects: CollectionEntry<'works'>[];
}

const { projects } = Astro.props;
---

<ol class="works-list">
	{projects.map((project) => (
		<li class="work-entry">
			<a class="work-entry__link" href={`/works/${project.id}/`}>
				<h3 class="work-entry__title">{project.data.title}</h3>
				<p class="work-entry__summary">{project.data.summary}</p>
				<p class="work-entry__stack">{project.data.technologies.slice(0, 6).join(' · ')}</p>
			</a>
		</li>
	))}
</ol>

<p class="more-link"><a class="text-link" href="/works">All works <span aria-hidden="true">→</span></a></p>
