---
---

<button class="theme-toggle" type="button" data-theme-toggle hidden>
	<svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
		<circle cx="12" cy="12" r="9"></circle>
		<path d="M12 3a9 9 0 0 0 0 18V3Z" fill="currentColor" stroke="none"></path>
	</svg>
	<span class="visually-hidden" data-theme-label>Switch theme</span>
</button>

<script>
	const THEME_STORAGE_KEY = 'color-scheme';
	const LEGACY_THEME_STORAGE_KEY = 'theme';
	const colorSchemeMeta = document.querySelector('meta[name="color-scheme"]');
	const themeColorMeta = document.querySelector('meta[name="theme-color"]');
	const themeToggle = document.querySelector('[data-theme-toggle]');
	const themeLabel = document.querySelector('[data-theme-label]');
	const systemDark = matchMedia('(prefers-color-scheme: dark)');

	// Kept in memory so the toggle still works when storage is blocked.
	let currentTheme: 'light' | 'dark' | null = null;

	const loadStoredTheme = () => {
		try {
			const stored = localStorage.getItem(THEME_STORAGE_KEY) ?? localStorage.getItem(LEGACY_THEME_STORAGE_KEY);
			return stored === 'light' || stored === 'dark' ? stored : null;
		} catch {
			return null;
		}
	};

	const readStoredTheme = () => currentTheme;

	const storeTheme = (theme: 'light' | 'dark' | null) => {
		currentTheme = theme;
		try {
			if (theme) localStorage.setItem(THEME_STORAGE_KEY, theme);
			else localStorage.removeItem(THEME_STORAGE_KEY);
			localStorage.removeItem(LEGACY_THEME_STORAGE_KEY);
		} catch {
			// Storage can be blocked; the in-memory theme still applies for this page.
		}
	};

	const systemTheme = () => (systemDark.matches ? 'dark' : 'light');
	const resolvedTheme = () => readStoredTheme() ?? systemTheme();

	const syncThemeColor = () => {
		themeColorMeta?.setAttribute('content', resolvedTheme() === 'dark' ? '#1b1b1b' : '#ffffff');
	};

	const syncColorScheme = () => {
		colorSchemeMeta?.setAttribute('content', readStoredTheme() ?? 'light dark');
	};

	const syncLabel = () => {
		if (themeLabel) {
			themeLabel.textContent =
				resolvedTheme() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
		}
	};

	const syncAll = () => {
		syncColorScheme();
		syncThemeColor();
		syncLabel();
	};

	themeToggle?.addEventListener('click', () => {
		const target = resolvedTheme() === 'dark' ? 'light' : 'dark';
		// Returning to the system preference clears the override instead of pinning it.
		storeTheme(target === systemTheme() ? null : target);
		syncAll();
	});

	// CSS follows the media query on its own; the browser chrome and label need syncing.
	systemDark.addEventListener('change', syncAll);

	addEventListener('storage', (event) => {
		if (event.key !== THEME_STORAGE_KEY && event.key !== LEGACY_THEME_STORAGE_KEY) return;
		currentTheme = loadStoredTheme();
		syncAll();
	});

	// Without JavaScript the toggle cannot work, so it stays hidden until now.
	currentTheme = loadStoredTheme();
	themeToggle?.removeAttribute('hidden');
	syncAll();
</script>
