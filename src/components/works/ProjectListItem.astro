---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'works'>;
}

const { project } = Astro.props;
const href = `/works/${project.id}/`;
---

<li>
	<a class="group relative -mx-3 block rounded-sm px-3 py-6 transition-colors duration-200 hover:bg-[var(--line)]/25 focus-visible:bg-[var(--line)]/25 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)] motion-reduce:transition-none sm:-mx-4 sm:px-4 sm:py-7" href={href}>
		<h2 class="flex items-baseline gap-2 text-lg leading-7 font-bold tracking-[-0.02em] md:text-xl">
			{project.data.title}
			<span class="inline-block text-sm text-[var(--muted)] transition-transform duration-200 group-hover:translate-x-1 group-focus-visible:translate-x-1 motion-reduce:transition-none" aria-hidden="true">↗</span>
		</h2>
		<p class="mt-1 max-w-[68ch] text-[0.9375rem] leading-6 text-[var(--muted)]">{project.data.summary}</p>
		<ul class="mt-3 flex flex-wrap gap-1.5" aria-label={`${project.data.title} technologies`}>
			{project.data.technologies.slice(0, 5).map((technology) => (
				<li class="rounded-md bg-[var(--badge)] px-2.5 py-1 text-xs font-semibold text-[var(--badge-text)]">{technology}</li>
			))}
		</ul>
	</a>
</li>
