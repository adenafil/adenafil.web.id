---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'works'>;
}

const { project } = Astro.props;
---

<li class="work-entry">
	<a class="work-entry__link" href={`/works/${project.id}/`}>
		<h2 class="work-entry__title">{project.data.title}</h2>
		<p class="work-entry__summary">{project.data.summary}</p>
		<p class="work-entry__stack">{project.data.technologies.slice(0, 6).join(' · ')}</p>
	</a>
</li>
