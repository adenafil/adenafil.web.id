---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'works'>;
	headingLevel?: 2 | 3;
}

const { project, headingLevel = 2 } = Astro.props;
const { cover, coverWidth, coverHeight } = project.data;
---

<li class="work-entry">
	<a class="work-entry__link" href={`/works/${project.id}/`}>
		{cover ? (
			<div class="work-entry__cover">
				<img
					src={cover}
					alt=""
					width={coverWidth ?? 1672}
					height={coverHeight ?? 941}
					loading="lazy"
					decoding="async"
				/>
			</div>
		) : (
			<div class="work-entry__cover work-entry__cover--fallback" aria-hidden="true">
				<span class="work-entry__cover-kicker">{project.data.technologies[0]}</span>
				<span class="work-entry__cover-title">{project.data.title}</span>
			</div>
		)}
		<div class="work-entry__body">
			{headingLevel === 3 ? (
				<h3 class="work-entry__title">{project.data.title}</h3>
			) : (
				<h2 class="work-entry__title">{project.data.title}</h2>
			)}
			<p class="work-entry__summary">{project.data.summary}</p>
			<p class="work-entry__stack">{project.data.technologies.slice(0, 6).join(' · ')}</p>
		</div>
	</a>
</li>
