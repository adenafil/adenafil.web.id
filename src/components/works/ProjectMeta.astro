---
interface Props {
	technologies: string[];
}

const { technologies } = Astro.props;
---

<div>
	<h2 class="text-xs font-semibold text-[var(--faint)]">Technologies</h2>
	<ul class="mt-3 flex flex-wrap gap-2" aria-label="Technologies used">
		{technologies.map((technology) => <li class="rounded-md bg-[var(--badge)] px-2.5 py-1 text-xs font-bold text-[var(--badge-text)]">{technology}</li>)}
	</ul>
</div>
