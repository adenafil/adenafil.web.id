---
interface Props {
	title: string;
	description: string;
	lang?: 'en' | 'id';
	image?: string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
	indexable?: boolean;
	canonical?: boolean;
}

const {
	title,
	description,
	lang = 'en',
	image = '/profile.jpg',
	imageAlt = 'Portrait of Ade Nafil Firmansah',
	imageWidth = 220,
	imageHeight = 220,
	structuredData,
	indexable = true,
	canonical = true,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
const twitterCard = imageWidth / imageHeight >= 1.5 ? 'summary_large_image' : 'summary';
const jsonLd = structuredData
	? JSON.stringify(structuredData).replaceAll('<', '\\u003c')
	: undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content={indexable ? 'index, follow' : 'noindex, follow'} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f4f4f1" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Ade Nafil Firmansah" />
		<meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:image:width" content={String(imageWidth)} />
		<meta property="og:image:height" content={String(imageHeight)} />
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={imageAlt} />
		{canonical && <link rel="canonical" href={canonicalURL} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
		<script is:inline>
			const savedTheme = localStorage.getItem('theme');
			const systemTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			document.documentElement.dataset.theme = savedTheme || systemTheme;
		</script>
	</head>
	<body>
		<a class="fixed top-2 left-2 z-20 -translate-y-[150%] bg-[var(--ink)] px-3 py-2 text-[var(--canvas)] focus:translate-y-0" href="#main-content">Skip to content</a>
		<slot />
	</body>
</html>
