---
import { Font } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import profileImage from '../assets/profile.jpg';

interface Props {
	title: string;
	description: string;
	lang?: 'en' | 'id';
	image?: ImageMetadata;
	imageAlt?: string;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
	indexable?: boolean;
	canonical?: boolean;
}

const {
	title,
	description,
	lang = 'en',
	image = profileImage,
	imageAlt = 'Portrait of Ade Nafil Firmansah',
	structuredData,
	indexable = true,
	canonical = true,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image.src, Astro.site);
const imageWidth = image.width;
const imageHeight = image.height;
const twitterCard = imageWidth / imageHeight >= 1.5 ? 'summary_large_image' : 'summary';
const jsonLd = structuredData
	? JSON.stringify(structuredData).replaceAll('<', '\\u003c')
	: undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content={indexable ? 'index, follow' : 'noindex, follow'} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" />
		<meta name="color-scheme" content="light dark" />
		<script is:inline>
			try {
				const colorSchemeMeta = document.querySelector('meta[name="color-scheme"]');
				const storedScheme = localStorage.getItem('color-scheme') ?? localStorage.getItem('theme');
				if (storedScheme === 'light' || storedScheme === 'dark') colorSchemeMeta.content = storedScheme;
				const isDark = colorSchemeMeta.content === 'dark'
					|| (colorSchemeMeta.content === 'light dark' && matchMedia('(prefers-color-scheme: dark)').matches);
				document.querySelector('meta[name="theme-color"]').setAttribute('content', isDark ? '#1b1b1b' : '#ffffff');
			} catch {}
		</script>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Ade Nafil Firmansah" />
		<meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:image:width" content={String(imageWidth)} />
		<meta property="og:image:height" content={String(imageHeight)} />
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={imageAlt} />
		{canonical && <link rel="canonical" href={canonicalURL} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<Font cssVariable="--font-ubuntu" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
		<title>{title}</title>
		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<slot />
	</body>
</html>
