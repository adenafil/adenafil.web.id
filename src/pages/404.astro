---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const title = 'Page not found · Ade Nafil Firmansah';
const description = 'The requested page could not be found.';
---

<Layout {title} {description} indexable={false} canonical={false}>
	<Header />
	<main id="main-content" class="site-container not-found" tabindex="-1">
		<p class="not-found__code">404</p>
		<h1>Page not found.</h1>
		<p class="not-found__copy">The page may have moved, or the address might be incorrect.</p>
		<nav class="not-found__links" aria-label="404 recovery">
			<a class="text-link" href="/">Back home</a>
			<a class="text-link" href="/works">View works</a>
		</nav>
	</main>
	<Footer />
</Layout>
