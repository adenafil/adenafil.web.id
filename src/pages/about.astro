---
import Footer from '../components/Footer';
import Header from '../components/Header.astro';
import { about, education, profile } from '../data/portfolio';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const title = `About ${profile.name} · Full-Stack Developer`;
const description = `Learn about ${profile.name}, his software development background, and education.`;
---

<Layout {title} {description}>
	<div id="top"></div>
	<Header />
	<main id="main-content" class="mx-auto min-h-[calc(100dvh-4rem)] w-[calc(100%-2rem)] max-w-6xl md:w-[calc(100%-3rem)]">
		<section class="max-w-4xl pt-16 pb-20 md:pt-24 md:pb-28" aria-labelledby="about-title">
			<h1 id="about-title" class="text-[2.5rem] leading-[1.05] font-semibold tracking-[-0.04em] md:text-6xl">About me</h1>
			<div class="mt-7 max-w-[72ch] space-y-4 text-base leading-7 text-[var(--muted)] md:text-lg md:leading-8">
				<p>{about.intro}</p>
				<p>{about.detail}</p>
			</div>
		</section>

		<section class="border-t border-[var(--line)] py-20 md:py-28" aria-labelledby="education-title">
			<h2 id="education-title" class="mb-12 text-2xl font-bold tracking-[-0.03em] md:mb-14 md:text-[1.7rem]">Education</h2>
			<div class="space-y-10">
				{education.map((item) => (
					<article class="grid grid-cols-[3rem_1fr] gap-x-5 gap-y-5 sm:grid-cols-[3.5rem_minmax(0,1fr)_auto] sm:items-start sm:gap-x-6" aria-label={`${item.degree} at ${item.institution}`}>
						<img class="size-12 border border-[var(--line)] bg-white object-contain p-1 sm:size-14" src="/uisi.jpg" alt="Universitas Internasional Semen Indonesia logo" width="56" height="56" loading="lazy" />
						<div>
							<h3 class="text-lg leading-7 font-bold tracking-[-0.02em] md:text-xl">{item.degree}</h3>
							<p class="mt-1 text-sm leading-6 text-[var(--muted)] md:text-base">{item.institution}</p>
						</div>
						<div class="col-start-2 flex flex-wrap gap-x-3 gap-y-1 text-sm font-semibold text-[var(--ink)] sm:col-start-3 sm:block sm:text-right">
							<time class="block tabular-nums">{item.period}</time>
							<p class="text-[var(--muted)] sm:mt-1">{item.gpa}</p>
						</div>
					</article>
				))}
			</div>
		</section>
	</main>
	<Footer />
</Layout>
