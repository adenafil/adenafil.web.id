---
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { about, education, profile } from '../data/portfolio';
import profileImage from '../assets/profile.jpg';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const title = `About ${profile.name} · Full-Stack Developer`;
const description = `Learn about ${profile.name}, his software development background, and education.`;
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	name: title,
	url: 'https://adenafil.web.id/about/',
	mainEntity: {
		'@type': 'Person',
		name: profile.name,
		jobTitle: profile.role,
		image: new URL(profileImage.src, 'https://adenafil.web.id').href,
		homeLocation: {
			'@type': 'Place',
			name: profile.location,
		},
		sameAs: ['https://github.com/adenafil', 'https://linkedin.com/in/adenafilf'],
	},
};
---

<Layout {title} {description} {structuredData}>
	<Header />
	<main id="main-content" tabindex="-1">
		<div class="site-container">
			<header class="page-header">
				<h1 class="page-title">About</h1>
			</header>

			<div class="about-copy">
				<p>{about.intro}</p>
				<p>{about.detail}</p>
			</div>

			<section class="section" aria-labelledby="education-title">
				<h2 id="education-title" class="section-title">Education</h2>
				<div>
					{education.map((item) => (
						<article class="education-entry">
							<h3 class="education-entry__degree">{item.degree}</h3>
							<p class="education-entry__meta">{item.institution} · {item.period} · {item.gpa}</p>
						</article>
					))}
				</div>
			</section>

			<Contact />
		</div>
	</main>
	<Footer />
</Layout>
