---
import { getCollection } from 'astro:content';
import Contact from '../components/Contact.astro';
import Experience from '../components/Experience.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Intro from '../components/Intro.astro';
import SelectedWorks from '../components/SelectedWorks.astro';
import Layout from '../layouts/Layout.astro';
import profileImage from '../assets/profile.jpg';
import '../styles/global.css';

const projects = (await getCollection('works', ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
	(a, b) => a.data.order - b.data.order,
);
const selectedWorks = projects.slice(0, 3);

const site = Astro.site!;
const title = 'Ade Nafil Firmansah · Full-Stack Developer';
const description =
	'Full-stack developer experienced in TypeScript, React, Laravel, NestJS, databases, background processing, testing, and deployment.';
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Ade Nafil Firmansah',
		url: site.href,
		inLanguage: 'en',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: 'Ade Nafil Firmansah',
		url: site.href,
		image: new URL(profileImage.src, site).href,
		jobTitle: 'Full-Stack Developer',
		homeLocation: {
			'@type': 'Place',
			name: 'Gresik, Indonesia',
		},
		sameAs: ['https://github.com/adenafil', 'https://linkedin.com/in/adenafilf'],
	},
];
---

<Layout {title} {description} {structuredData}>
	<Header />
	<main id="main-content" tabindex="-1">
		<Intro />

		<section class="site-wide section" aria-labelledby="selected-works-title">
			<h2 id="selected-works-title" class="section-title">Selected Works</h2>
			<SelectedWorks projects={selectedWorks} />
		</section>

		<Experience />
		<Contact />
	</main>
	<Footer />
</Layout>
