---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectImage from '../../components/works/ProjectImage.astro';
import ProjectImageGrid from '../../components/works/ProjectImageGrid.astro';
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
	const projects = await getCollection('works', ({ data }) => (import.meta.env.PROD ? !data.draft : true));

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<'works'>;
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const { data } = project;
const title = `${data.title} · Works · Ade Nafil Firmansah`;
const description = data.summary;
const hasLinks = Boolean(data.links.live || data.links.source || data.links.sources?.length);
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showContents = tableOfContents.length >= 4;
const site = Astro.site!;
const projectURL = new URL(`/works/${project.id}/`, site).href;
const imageAlt = data.coverAlt;
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: data.title,
		description,
		url: projectURL,
		inLanguage: data.lang,
		creator: {
			'@type': 'Person',
			name: 'Ade Nafil Firmansah',
			url: site.href,
		},
		mainEntityOfPage: projectURL,
		keywords: data.technologies.join(', '),
		...(data.cover ? { image: new URL(data.cover.src, site).href } : {}),
		...(data.links.live ? { sameAs: data.links.live } : {}),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: site.href,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Works',
				item: new URL('/works/', site).href,
			},
			{
				'@type': 'ListItem',
				position: 3,
				name: data.title,
				item: projectURL,
			},
		],
	},
];
---

<Layout {title} {description} lang={data.lang} image={data.cover} {imageAlt} {structuredData}>
	<Header />
	<main id="main-content" tabindex="-1">
		<article class="project-layout">
			<div class="project-back">
				<a class="text-link" href="/works"><span aria-hidden="true">←</span> All works</a>
			</div>

			<header class="project-header">
				<h1 class="project-title">{data.title}</h1>
				<p class="project-summary">{data.summary}</p>
				{hasLinks && (
					<div class="project-links">
						{data.links.live && <a class="text-link" href={data.links.live} target="_blank" rel="noreferrer">Live preview <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a>}
						{data.links.source && <a class="text-link" href={data.links.source} target="_blank" rel="noreferrer">Source code <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a>}
						{data.links.sources?.map((source) => <a class="text-link" href={source.url} target="_blank" rel="noreferrer">{source.label} <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a>)}
					</div>
				)}
				<p class="project-stack"><span class="project-stack__label">Stack:</span> {data.technologies.join(' · ')}</p>
			</header>

			{data.cover && data.coverAlt && (
				<div class:list={['project-cover', { 'project-cover-portrait': data.coverLayout === 'portrait' }]}>
					<ProjectImage
						src={data.cover}
						alt={data.coverAlt}
						caption={data.coverCaption}
						priority
					/>
				</div>
			)}

			{showContents && (
				<nav class="project-contents" aria-labelledby="project-contents-title">
					<p id="project-contents-title" class="project-contents__title">Contents</p>
					<ol>
						{tableOfContents.map((heading) => (
							<li class:list={['project-contents__item', heading.depth === 3 && 'project-contents__item--nested']}>
								<a href={`#${heading.slug}`}>{heading.text}</a>
							</li>
						))}
					</ol>
				</nav>
			)}

			<div class="project-content">
				<Content components={{ ProjectImage, ProjectImageGrid }} />
			</div>
		</article>
	</main>
	<Footer />
</Layout>
