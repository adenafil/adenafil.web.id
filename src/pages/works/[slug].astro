---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Footer from '../../components/Footer';
import Header from '../../components/Header.astro';
import ProjectImage from '../../components/works/ProjectImage.astro';
import ProjectImageGrid from '../../components/works/ProjectImageGrid.astro';
import ProjectMeta from '../../components/works/ProjectMeta.astro';
import ProjectTableOfContents from '../../components/works/ProjectTableOfContents.astro';
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
	const projects = await getCollection('works', ({ data }) => import.meta.env.PROD ? !data.draft : true);

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<'works'>;
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const { data } = project;
const title = `${data.title} · Works · Ade Nafil Firmansah`;
const description = data.summary;
const hasLinks = Boolean(data.links.live || data.links.source || data.links.sources?.length);
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const projectURL = `https://adenafil.web.id/works/${project.id}/`;
const image = data.cover;
const imageAlt = data.coverAlt;
const imageWidth = data.coverWidth;
const imageHeight = data.coverHeight;
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: data.title,
		description,
		url: projectURL,
		inLanguage: data.lang,
		creator: {
			'@type': 'Person',
			name: 'Ade Nafil Firmansah',
			url: 'https://adenafil.web.id/',
		},
		mainEntityOfPage: projectURL,
		keywords: data.technologies.join(', '),
		...(data.cover ? { image: new URL(data.cover, 'https://adenafil.web.id').href } : {}),
		...(data.links.live ? { sameAs: data.links.live } : {}),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: 'https://adenafil.web.id/',
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Works',
				item: 'https://adenafil.web.id/works/',
			},
			{
				'@type': 'ListItem',
				position: 3,
				name: data.title,
				item: projectURL,
			},
		],
	},
];
---

<Layout {title} {description} lang={data.lang} {image} {imageAlt} {imageWidth} {imageHeight} {structuredData}>
	<div id="top"></div>
	<Header />
	<main id="main-content">
		<article class="project-layout">
			<div class="project-main min-w-0">
				<header class="pt-10 pb-8 md:pt-14 md:pb-10">
					<a class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--muted)] transition-colors hover:text-[var(--ink)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]" href="/works">
						<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M19 12H5m5-5-5 5 5 5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
						All works
					</a>

					<div class="mt-9 md:mt-11">
						<h1 class="text-[2.25rem] leading-[1.08] font-semibold tracking-[-0.035em] sm:text-5xl">{data.title}</h1>
						<p class="mt-5 max-w-[78ch] text-base leading-7 text-[var(--muted)] md:text-lg md:leading-8">{data.summary}</p>
						{hasLinks && (
							<div class="mt-7 flex flex-wrap gap-x-6 gap-y-3">
								{data.links.live && <a class="text-sm font-semibold underline decoration-[var(--line)] underline-offset-4 hover:decoration-[var(--accent)]" href={data.links.live} target="_blank" rel="noreferrer">Live preview <span aria-hidden="true">↗</span></a>}
								{data.links.source && <a class="text-sm font-semibold underline decoration-[var(--line)] underline-offset-4 hover:decoration-[var(--accent)]" href={data.links.source} target="_blank" rel="noreferrer">Source code <span aria-hidden="true">↗</span></a>}
								{data.links.sources?.map((source) => <a class="text-sm font-semibold underline decoration-[var(--line)] underline-offset-4 hover:decoration-[var(--accent)]" href={source.url} target="_blank" rel="noreferrer">{source.label} <span aria-hidden="true">↗</span></a>)}
							</div>
						)}
						<div class="mt-7 border-t border-[var(--line)] pt-5">
							<ProjectMeta technologies={data.technologies} />
						</div>
						{tableOfContents.length > 0 && (
							<div class="mt-8">
								<ProjectTableOfContents headings={tableOfContents} mode="mobile" />
							</div>
						)}
					</div>
				</header>

				{data.cover && data.coverAlt && (
					<div class:list={['project-cover', { 'project-cover-portrait': data.coverLayout === 'portrait' }]}>
						<ProjectImage
							src={data.cover}
							alt={data.coverAlt}
							width={data.coverWidth ?? 1919}
							height={data.coverHeight ?? 917}
							caption={data.coverCaption}
							priority
						/>
					</div>
				)}

				<div class="pt-7 pb-9 md:pt-8 md:pb-12">
					<div class="project-content">
						<Content components={{ ProjectImage, ProjectImageGrid }} />
					</div>
				</div>
			</div>

			{tableOfContents.length > 0 && <ProjectTableOfContents headings={tableOfContents} mode="desktop" />}
		</article>
	</main>
	<Footer />
</Layout>
