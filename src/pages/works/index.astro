---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer';
import Header from '../../components/Header.astro';
import ProjectListItem from '../../components/works/ProjectListItem.astro';
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

const projects = (await getCollection('works', ({ data }) => import.meta.env.PROD ? !data.draft : true))
	.sort((a, b) => a.data.order - b.data.order);

const title = 'Works · Ade Nafil Firmansah';
const description = 'Selected software projects built by Ade Nafil Firmansah.';
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: title,
	description,
	url: 'https://adenafil.web.id/works/',
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: projects.map((project, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: project.data.title,
			url: `https://adenafil.web.id/works/${project.id}/`,
		})),
	},
};
---

<Layout {title} {description} {structuredData}>
	<div id="top"></div>
	<Header />
	<main id="main-content" class="site-container min-h-[calc(100dvh-4rem)]">
		<header class="max-w-3xl pt-14 pb-8 md:pt-20 md:pb-10">
			<h1 class="text-2xl leading-8 font-bold tracking-[-0.02em] md:text-[1.75rem] md:leading-9">Works</h1>
			<p class="mt-3  text-[0.9375rem] leading-6 text-[var(--muted)]">A selection of applications, backend systems, and practical tools I have helped build.</p>
		</header>

		<section class="pb-20 md:pb-28" aria-label="Selected projects">
			{projects.length > 0 ? (
				<ol class="project-list m-0 grid list-none grid-cols-1 gap-x-12 p-0 md:grid-cols-2">
					{projects.map((project) => <ProjectListItem project={project} />)}
				</ol>
			) : (
				<p class="border-y border-[var(--line)] py-8 text-[var(--muted)]">Project case studies are being prepared.</p>
			)}
		</section>
	</main>
	<Footer />
</Layout>
