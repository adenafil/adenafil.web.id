---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectListItem from '../../components/works/ProjectListItem.astro';
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

const projects = (await getCollection('works', ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
	(a, b) => a.data.order - b.data.order,
);

const title = 'Works · Ade Nafil Firmansah';
const description = 'Selected software projects built by Ade Nafil Firmansah.';
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: title,
	description,
	url: 'https://adenafil.web.id/works/',
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: projects.map((project, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: project.data.title,
			url: `https://adenafil.web.id/works/${project.id}/`,
		})),
	},
};
---

<Layout {title} {description} {structuredData}>
	<Header />
	<main id="main-content">
		<header class="site-container page-header">
			<h1 class="page-title">Works</h1>
			<p class="page-lede">Selected software projects, from scheduling systems and e-commerce to internal tools and mobile apps.</p>
		</header>

		<section class="site-wide works-section" aria-label="Selected projects">
			{projects.length > 0 ? (
				<ol class="works-list">
					{projects.map((project) => <ProjectListItem project={project} />)}
				</ol>
			) : (
				<p>Project case studies are being prepared.</p>
			)}
		</section>
	</main>
	<Footer />
</Layout>
